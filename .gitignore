# Third-party video transcripts: keep local, do not publish.
experiments/*/transcript.txt

# Raw market-data snapshots in experiments: keep local, do not publish (see THIRD_PARTY_NOTICES.md).
experiments/*/*.csv
!experiments/*/STACK.csv
!experiments/*/PORTFOLIO.csv

# AI Macro Nexus research: Visser/22V subscriber data and fetched market data stay local.
# Only code and the content-free methodology are tracked; outputs quote subscriber research.
experiments/ai_nexus_lagging_inflection/*
!experiments/ai_nexus_lagging_inflection/*.py
!experiments/ai_nexus_lagging_inflection/METHODOLOGY.md

# Crypto usage/Jev exploratory outputs stay local; only code and method are tracked.
experiments/visser_crypto_verticals/jev_usage/*
!experiments/visser_crypto_verticals/jev_usage/*.py
!experiments/visser_crypto_verticals/jev_usage/METHOD.md

# 22V subscriber papers and notes derived from them stay local.
experiments/visser_ai_bubble/*.pdf
experiments/visser_ai_bubble/PAPER_NOTES*.md

# Beat-vs-price test outputs stay local (derived from subscriber universe + market data).
experiments/beat_vs_price_q3_2026/*
!experiments/beat_vs_price_q3_2026/*.py
!experiments/beat_vs_price_q3_2026/PREREGISTRATION.md

